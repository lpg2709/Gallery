<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/video_edit_root"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@android:color/black"
    android:orientation="vertical">

    <org.fossify.commons.views.MyAppBarLayout
        android:id="@+id/video_edit_appbar"
        android:layout_width="match_parent"
        android:layout_height="wrap_content">

        <com.google.android.material.appbar.MaterialToolbar
            android:id="@+id/video_edit_toolbar"
            android:layout_width="match_parent"
            android:layout_height="?attr/actionBarSize"
            android:background="@color/color_primary"
            app:menu="@menu/menu_video_edit"
            app:title="@string/video_editor"
            app:titleTextAppearance="@style/AppTheme.ActionBar.TitleTextStyle" />

    </org.fossify.commons.views.MyAppBarLayout>

    <FrameLayout
        android:id="@+id/preview_holder"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:clipChildren="false">

        <TextureView
            android:id="@+id/video_surface"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:layout_gravity="center" />

        <ImageView
            android:id="@+id/video_play_outline"
            android:layout_width="@dimen/play_outline_size_big"
            android:layout_height="@dimen/play_outline_size_big"
            android:layout_gravity="center"
            android:padding="20dp"
            android:src="@drawable/ic_play_outline_vector" />

    </FrameLayout>

    <androidx.constraintlayout.widget.ConstraintLayout
        android:id="@+id/video_time_holder"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:paddingTop="@dimen/medium_margin">

        <ImageView
            android:id="@+id/frame_previous"
            android:layout_width="@dimen/video_player_play_pause_size"
            android:layout_height="@dimen/video_player_play_pause_size"
            android:background="?attr/selectableItemBackgroundBorderless"
            android:contentDescription="@string/video_frame_previous"
            android:padding="@dimen/normal_margin"
            android:src="@drawable/ic_prev_outline_vector"
            app:layout_constraintEnd_toStartOf="@id/frame_next"
            app:layout_constraintHorizontal_chainStyle="packed"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="parent" />

        <ImageView
            android:id="@+id/frame_next"
            android:layout_width="@dimen/video_player_play_pause_size"
            android:layout_height="@dimen/video_player_play_pause_size"
            android:background="?attr/selectableItemBackgroundBorderless"
            android:contentDescription="@string/video_frame_next"
            android:padding="@dimen/normal_margin"
            android:src="@drawable/ic_next_outline_vector"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toEndOf="@id/frame_previous"
            app:layout_constraintTop_toTopOf="parent" />

        <TextView
            android:id="@+id/video_curr_time"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:background="?attr/selectableItemBackgroundBorderless"
            android:gravity="center_vertical"
            android:paddingLeft="@dimen/activity_margin"
            android:paddingRight="@dimen/activity_margin"
            android:shadowColor="@color/default_background_color"
            android:shadowRadius="2"
            android:textColor="@android:color/white"
            app:layout_constraintBottom_toBottomOf="@id/video_seek_holder"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="@id/video_seek_holder" />

        <FrameLayout
            android:id="@+id/video_seek_holder"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            app:layout_constraintEnd_toStartOf="@id/video_duration"
            app:layout_constraintStart_toEndOf="@id/video_curr_time"
            app:layout_constraintTop_toBottomOf="@id/frame_previous">

            <org.fossify.commons.views.MySeekBar
                android:id="@+id/video_seekbar"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:paddingTop="@dimen/activity_margin"
                android:paddingBottom="@dimen/activity_margin" />

            <org.fossify.gallery.views.VideoTrimOverlay
                android:id="@+id/trim_overlay"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_gravity="center_vertical"
                android:visibility="gone" />

        </FrameLayout>

        <TextView
            android:id="@+id/video_duration"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:background="?attr/selectableItemBackgroundBorderless"
            android:gravity="center_vertical"
            android:paddingLeft="@dimen/activity_margin"
            android:paddingRight="@dimen/activity_margin"
            android:shadowColor="@color/default_background_color"
            android:shadowRadius="2"
            android:textColor="@android:color/white"
            app:layout_constraintBottom_toBottomOf="@id/video_seek_holder"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintTop_toTopOf="@id/video_seek_holder" />

    </androidx.constraintlayout.widget.ConstraintLayout>

    <LinearLayout
        android:id="@+id/edit_actions"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="#CC000000"
        android:gravity="center"
        android:orientation="horizontal"
        android:paddingTop="@dimen/small_margin"
        android:paddingBottom="@dimen/small_margin">

            <LinearLayout
                android:id="@+id/action_rotate"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:background="?attr/selectableItemBackground"
                android:gravity="center"
                android:orientation="vertical"
                android:padding="@dimen/tiny_margin">

                <ImageView
                    android:id="@+id/action_rotate_icon"
                    android:layout_width="32dp"
                    android:layout_height="32dp"
                    android:contentDescription="@string/change_orientation"
                    android:src="@drawable/ic_rotate_right_vector" />

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:ellipsize="end"
                    android:gravity="center"
                    android:maxLines="2"
                    android:text="@string/change_orientation"
                    android:textColor="@android:color/white"
                    android:textSize="@dimen/small_text_size" />

            </LinearLayout>

            <LinearLayout
                android:id="@+id/action_mute"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:background="?attr/selectableItemBackground"
                android:gravity="center"
                android:orientation="vertical"
                android:padding="@dimen/tiny_margin">

                <ImageView
                    android:id="@+id/action_mute_icon"
                    android:layout_width="32dp"
                    android:layout_height="32dp"
                    android:contentDescription="@string/video_mute"
                    android:src="@drawable/ic_vector_speaker_on" />

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:ellipsize="end"
                    android:gravity="center"
                    android:maxLines="2"
                    android:text="@string/video_mute"
                    android:textColor="@android:color/white"
                    android:textSize="@dimen/small_text_size" />

            </LinearLayout>

            <LinearLayout
                android:id="@+id/action_crop"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:background="?attr/selectableItemBackground"
                android:gravity="center"
                android:orientation="vertical"
                android:padding="@dimen/tiny_margin">

                <ImageView
                    android:id="@+id/action_crop_icon"
                    android:layout_width="32dp"
                    android:layout_height="32dp"
                    android:contentDescription="@string/crop"
                    android:src="@drawable/ic_video_trim_vector" />

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:ellipsize="end"
                    android:gravity="center"
                    android:maxLines="2"
                    android:text="@string/crop"
                    android:textColor="@android:color/white"
                    android:textSize="@dimen/small_text_size" />

            </LinearLayout>

            <LinearLayout
                android:id="@+id/action_extract"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:background="?attr/selectableItemBackground"
                android:gravity="center"
                android:orientation="vertical"
                android:padding="@dimen/tiny_margin">

                <ImageView
                    android:id="@+id/action_extract_icon"
                    android:layout_width="32dp"
                    android:layout_height="32dp"
                    android:contentDescription="@string/extract_frame"
                    android:src="@drawable/ic_extract_frame_vector" />

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:ellipsize="end"
                    android:gravity="center"
                    android:maxLines="2"
                    android:text="@string/video_extract_frame"
                    android:textColor="@android:color/white"
                    android:textSize="@dimen/small_text_size" />

            </LinearLayout>

    </LinearLayout>

</LinearLayout>
